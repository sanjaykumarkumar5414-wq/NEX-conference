# SMTP Configuration
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=your-smtp-password-here
SMTP_FROM=nexsmtp@nexware-global.com

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password-here
DB_NAME=conference_booking

# JWT Secret (set a strong secret in production)
JWT_SECRET=your-jwt-secret-change-in-production

# WhatsApp session path (outside Jenkins workspace for persistence across deployments)
# Default: /home/ubuntu/whatsapp-session
# WHATSAPP_SESSION_PATH=/home/ubuntu/whatsapp-session

# Set to true to clear existing WhatsApp session and prompt for new QR code on next start.
# Remove this variable after scanning the new QR to avoid clearing on every restart.
# CLEAR_WHATSAPP_SESSION=true

# HR WhatsApp number for new booking request alerts (10 digits, India). Default: 8870957458
# WHATSAPP_HR_NUMBER=8870957458
